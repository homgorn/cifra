YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
YANDEX_OAUTH_TOKEN=
# Токен Директа. Отдельным ключом, а не общим с остальными: Директ
# требует подать заявку на доступ к API отдельно, даже если право уже
# добавлено в приложение на oauth.yandex.ru. С общим токеном ошибка
# доступа выглядит как «нет доступа», и непонятно, к чему она относится.
# Если ключ пуст, используется YANDEX_OAUTH_TOKEN.
DIRECT_OAUTH_TOKEN=
# Песочница Директа. Токен у неё свой, ошибки выглядят так же, как у
# боевого контура, и без этого флага легко час чинить рабочее
# приложение, которое на самом деле работает с тестовыми данными.
DIRECT_SANDBOX=0
# Логин владельца сайта в Яндексе и его идентификатор. Нужны для отчётов
# Вебмастера и для OAuth. Это контактные данные, они же лежат в
# schema.org-разметке на сайте, но токен при этом хранится только здесь.
YANDEX_ACCOUNT_EMAIL=
YANDEX_ID=
# Счётчик сайта цифра18.рф: визиты на сайт, e-commerce, цели.
METRIKA_COUNTER_ID=50863157
# Счётчик карточки в Яндекс Картах: просмотры карточки, НЕ визиты на сайт.
# Найден 2026-09-27: ранний разбор Метрики был построен на нём, поэтому
# «79 002 визита» и «отказы 75%» в отчёте описывали карточку, а не сайт.
METRIKA_MAPS_COUNTER_ID=59102713
