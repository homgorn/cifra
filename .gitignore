# OAuth-данные Яндекса. client_secret из oauth.yandex.ru попал в публичный
# репозиторий в коммите 362e84f, поэтому файл удалён, а не просто скрыт.
# Идентификатор приложения берётся из .env, auth-url собирает
# scripts/export/yandex_oauth.py. Ничего из этого не коммитим.
oauth*.txt
yandex api/
*.client_secret

# Офисные документы и заметки в корне проекта.
#
# cifra.odt содержит выгруженные учётные данные: client_secret Яндекса,
# пароль Topvisor, пароли админки. Файл не закоммичен, и он не должен
# попасть в git никогда: офисный формат не проходит мимо git add -A,
# а в нём секреты лежат открытым текстом. Хранить такие файлы нужно
# вне репозитория.
*.odt
*.odt.*
/cifra*.odt
/поставщики.txt

# Любой текстовый файл в корне проекта, кроме README.
# В корне допустимы только файлы, которые перечислены ниже явно.
/*.txt
!/.gitignore
!/читать-меня.txt
