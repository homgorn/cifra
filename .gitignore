# OAuth-данные Яндекса. client_secret из oauth.yandex.ru попал в публичный
# репозиторий в коммите 362e84f, поэтому файл удалён, а не просто скрыт.
# Идентификатор приложения берётся из .env, auth-url собирает
# scripts/export/yandex_oauth.py. Ничего из этого не коммитим.
oauth*.txt
yandex api/
*.client_secret

# Офисные документы и заметки в корне проекта.
#
# cifra.odt содержит выгруженные учётные данные: client_secret Яндекса,
# пароль Topvisor, пароли админки. Файл не закоммичен, и он не должен
# попасть в git никогда: офисный формат не проходит мимо git add -A,
# а в нём секреты лежат открытым текстом. Хранить такие файлы нужно
# вне репозитория.
*.odt
*.odt.*
/cifra*.odt
/поставщики.txt

# Любой текстовый файл в корне проекта, кроме README.
# В корне допустимы только файлы, которые перечислены ниже явно.
/*.txt
!/.gitignore
!/читать-меня.txt

# Сырая выкачка сайта заказчика: 457 html по 62,7 МБ.
#
# Не в git по двум причинам, и обе самостоятельные.
#
# Первая: в HTML каждой страницы Битрикс24 лежит sessid, идентификатор
# сессии, и в выкачке таких вхождений 2283 в 457 файлах. Это токен
# клиента, а не наш. Папка была закоммичена вместе с ними.
#
# Вторая: это не наш исходный код, а копия чужого сайта. Хранить её в
# истории репозитория незачем: она воспроизводится одной командой
# fetch_catalog.py, а место в коммитах занимает столько же, сколько
# весь остальной проект.
#
# Что делать, если понадобится переразобрать: fetch_catalog.py --parse-only
# читает папку локально, git для этого не нужен.
#
# ВАЖНО. Папка уже в истории. Чистка рабочей копии (scrub_raw_tokens.py)
# новых попаданий не добавляет, но старые коммиты остаются. Оттуда токены
# убираются только перезаписью истории, см. landings/reports/09_*.md
/landings/_scrape/raw/

# Скриншоты панели браузера, инструмент создаёт их сам.
.openchamber/

# Лиды заглушки Битрикс24: тестовые, с выдуманными именами и телефонами.
/landings/_scrape/out/leads.json

# Журнал обхода. Полезен при разборе конкретного прогона, но это лог.
/landings/_scrape/run2.log

# Файлы блокировки LibreOffice, .~lock.cifra.odt# и подобные. Появляются,
# пока документ открыт в офисном пакете, и живут после его закрытия.
# Правило *.odt.* их не ловит: имя начинается с точки, а после odt стоит
# решётка, а не имя файла.
.~lock.*#
.~lock.*

# Снимки экрана, сделанные инструментом браузера во время проверки. Они
# попадали в индекс под именами вида screencapture-file-... и лежали в папке
# «New folder», то есть это были артефакты проверки, а не часть проекта.
# Полезной ценности в них нет, весили 5,4 МБ. Пути в отчётах указывают на
# landings/reports/, а сами снимки хранятся во временном каталоге.
screencapture-*.png
landings/New folder/
landings/screens/
