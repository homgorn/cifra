      "schema:description": "Фотообои и фрески бесшовные: печать на виниле (виниловые обои), флизелине (флизелиновые обои), ткани (текстильные обои). Бесшовные панели до 3-5м ширины. Монтаж на клей, самоклеящиеся.",
      "cifra:hasPrintMethod": ["cifra:UVPrint", "cifra:LatexPrint"],
      "cifra:hasMaterial": ["cifra:material_vinyl_wallpaper", "cifra:material_fleece_wallpaper", "cifra:material_fabric_wallpaper"],
      "cifra:hasMaxFormat": "3-5м (бесшовные панели)",
