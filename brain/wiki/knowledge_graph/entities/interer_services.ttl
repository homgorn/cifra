      "rdfs:label": "Картины на холсте индивидуальный размер",
      "rdfs:comment": "Картины на холсте нестандартного размера под заказ",
      "schema:description": "Картины на холсте нестандартного размера под заказ. Любой размер до 1.5х3м. Натяжка на подрамник, багетирование, рама. Готовые к подвешиванию.",
      "cifra:hasPrintMethod": "cifra:WideFormatInkjet",
      "cifra:hasMaterial": "cifra:material_canvas",
      "cifra:hasMaxFormat": "1.5x3 м",
      "cifra:hasMinTirage": 1
    },
    {
      "@id": "cifra:service_interer_fotopostery_na_penokartone",
      "@type": "cifra:PrintService",
      "rdfs:label": "Фотопостеры на пенокартоне",
      "rdfs:comment": "Фотопостеры на пенокартоне (пенопласт 3-5мм): легкие, жесткие, не деформируются",
      "schema:description": "Фотопостеры на пенокартоне (пенопласт 3мм, 5мм): легкие, жесткие, не деформируются. Монтируются на стену на двусторонний скотч, магниты, кнопки. Идеально для временных выставок, офисов, дома.",
      "cifra:hasPrintMethod": "cifra:UVPrint",
      "cifra:hasMaterial": "cifra:material_penokarton",
      "cifra:hasMaxFormat": "1.2x2.4 м",
      "cifra:hasMinTirage": 1
    },
    {
