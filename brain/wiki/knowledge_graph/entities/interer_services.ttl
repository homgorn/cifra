      "@type": "cifra:PrintService",
      "rdfs:label": "Печать на холсте в рулоне",
      "rdfs:comment": "Печать на холсте в рулоне для натяжки на подрамник",
      "schema:description": "Печать на холсте в рулоне (ширина до 1.5м) для самостоятельной натяжки на подрамник или багетирования. Художественный холст, фото-холст, синтетический холст.",
      "cifra:hasPrintMethod": "cifra:WideFormatInkjet",
      "cifra:hasMaterial": "cifra:material_canvas",
      "cifra:hasMaxFormat": "1.5м (ширина рулона)",
      "cifra:hasMinTirage": 1
    },
    {
      "@id": "cifra:service_interer_kartiny_na_kholste_individualnyy_razmer",
