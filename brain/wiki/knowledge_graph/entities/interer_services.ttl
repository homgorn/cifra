  "@graph": [
    {
      "@id": "cifra:service_interer_kartiny_na_kholste",
      "@type": "cifra:PrintService",
      "rdfs:label": "Картины на холсте",
      "rdfs:comment": "Печать на холсте: художественные репродукции, фото на холсте",
      "schema:description": "Печать на холсте (холст-холст, художественный холст): художественные репродукции, фото на холсте, модные постеры. Натяжка на подрамник (кель), багетирование. Размеры до 1.5х3м.",
      "cifra:hasPrintMethod": "cifra:WideFormatInkjet",
      "cifra:hasMaterial": "cifra:material_canvas",
      "cifra:hasMaxFormat": "1.5x3 м",
      "cifra:hasMinTirage": 1
    },
    {
      "@id": "cifra:service_interer_postery",
      "@type": "cifra:PrintService",
      "rdfs:label": "Постеры",
      "rdfs:comment": "Постеры на постерной бумаге, фото-бумаге, холсте",
      "schema:description": "Постеры на постерной бумаге (меловка, фото-бумага), холсте, фото-бумаге. Постеры для интерьера, рекламы, событий. Ламинация, фрейминг.",
      "cifra:hasPrintMethod": ["cifra:WideFormatInkjet", "cifra:UVPrint"],
      "cifra:hasMaterial": "cifra:material_paper_poster",
      "cifra:hasMaxFormat": "1.6м",
      "cifra:hasMinTirage": 1
    },
    {
