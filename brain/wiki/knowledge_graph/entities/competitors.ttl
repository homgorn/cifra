      "@id": "cifra:competitor/printio",
      "@type": "cifra:Competitor",
      "rdfs:label": "Printio",
      "rdfs:comment": "POD маркетплейс (Print on Demand) — крупнейший в РФ",
      "schema:description": "Printio — маркетплейс печать по требованию (Print on Demand). 150+ товаров, 700K+ дизайнов. API для партнеров, интеграции с Shopify/WooCommerce. СДЭК/Почта России по РФ. Фокус на мерч: одежда, аксессуары, товары для дома. Нет офсетной печати, нет широкоформатной, нет инженерной печати. Качество POD ниже офсета.",
      "cifra:competitorType": "POD Marketplace",
      "cifra:merchSKU": 150,
      "cifra:hasAPI": true,
      "cifra:hasOnlineEditor": true,
      "cifra:hasSDEKIntegration": true,
      "cifra:hasShopifyPlugin": true,
      "cifra:hasWooCommercePlugin": true,
      "cifra:strengths": ["Huge catalog", "API/Integrations", "Brand recognition", "SDEK integration", "No minimum order"],
      "cifra:weaknesses": ["No offset printing", "No wide-format", "No engineering print", "POD quality < offset", "No consulting"],
      "cifra:trafficEstimate": "2-3M visits/month",
      "cifra:topKeywords": ["футболки с логотипом", "кружки с логотипом", "толстовки с принтом", "мерч с логотипом", "напечатать на футболке"],
      "cifra:threatLevel": "Critical"
    },
    {
      "@id": "cifra:competitor/ruprint",
      "@type": "cifra:Competitor",
      "rdfs:label": "RuPrint",
      "rdfs:comment": "Онлайн-типография (Москва) — полный цикл: цифровая + офсет + широкоформат",
      "schema:description": "RuPrint — онлайн-типография в Москве с полным циклом: цифровая печать, офсетная печать, широкоформатная печать (баннеры до 3.2м, пленки, ткани), сувенирка (352 SKU). Офсетная печать дешевле на больших тиражах. Широкоформат: баннеры, пленки, ткани. Доставка СДЭК/Boxberry/Почта России по РФ. B2B фокус: корпоративные клиенты, оптовые цены, персональный менеджер.",
      "cifra:competitorType": "Online Print Shop",
      "cifra:catalogSize": 1548,
      "cifra:hasOffsetPrint": true,
      "cifra:hasDigitalPrint": true,
      "cifra:hasWideFormat": true,
