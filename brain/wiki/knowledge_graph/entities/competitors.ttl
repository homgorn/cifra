      "cifra:hasSDEKDelivery": true,
      "cifra:hasOnlineCalculator": false,
      "cifra:hasAPI": false,
      "cifra:strengths": ["Full print cycle", "Offset + Digital + Wide-format", "B2B focus", "Expert content (journal)", "Russia-wide delivery"],
      "cifra:weaknesses": ["No instant calculator", "No online editor", "No API", "No local pickup in regions", "Moscow-centric"],
      "cifra:trafficEstimate": "Significant B2B traffic",
