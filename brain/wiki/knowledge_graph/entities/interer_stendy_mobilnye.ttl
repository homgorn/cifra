      "rdfs:comment": "Ксерокопия А3, А4, А2, А1, А0 форматов",
      "schema:description": "Ксерокопия чертежей и документов форматов А3, А4, А2, А1, А0. ЧБ и цветная. Скорость до 100 экз/мин.",
      "cifra:hasPrintMethod": "cifra:Xerography",
      "cifra:hasMaxFormat": "А0",
      "cifra:hasMinTirage": 1
