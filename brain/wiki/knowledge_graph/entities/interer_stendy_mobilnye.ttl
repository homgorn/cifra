      "schema:description": "Сканирование чертежей, документов, карт, схем до формата А0+. Разрешение 300-600 dpi. Форматы: PDF, TIFF, JPEG, DWG. Распознавание текста (OCR).",
      "cifra:hasPrintMethod": "cifra:LargeFormatScanning",
      "cifra:hasMaxFormat": "А0+",
      "cifra:hasMinTirage": 1
    },
    {
