      "rdfs:comment": "Напольные и настенные стенды: поп-ап, роллап, Х-стенд, Л-стенд, пресс-волл",
      "schema:description": "Напольные и настенные стенды: поп-ап (Pop-Up), роллап (Roll-Up), Х-стенд, Л-стенд, пресс-волл, штендеры, стенды из оргстекла. Каркас: алюминий, пластик, композит. Печать на ткани, пленке, бумаге.",
      "cifra:hasPrintMethod": ["cifra:WideFormatInkjet", "cifra:UVPrint"],
      "cifra:hasMaxFormat": "2x3 м",
      "cifra:hasMinTirage": 1
    },
