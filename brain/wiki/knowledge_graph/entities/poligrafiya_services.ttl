      "schema:description": "Печать лекал и выкроек на трафаретной бумаге для производства одежды, обуви, мебели. Крупноформатная печать на рулоне.",
      "cifra:hasPrintMethod": "cifra:WideFormatInkjet",
      "cifra:hasMaxFormat": "1.6м",
      "cifra:hasMinTirage": 1
    },
    {
      "@id": "cifra:service_poligrafiya_pakety",
      "@type": "cifra:PrintService",
      "rdfs:label": "Пакеты",
      "rdfs:comment": "Бумажные пакеты с логотипом: крафт, белые, мелованные",
      "cifra:hasPrintMethod": ["cifra:OffsetPrint", "cifra:FlexoPrint"],
      "cifra:hasFinishing": ["cifra:Lamination", "cifra:UVVarnish", "cifra:DieCutting"],
      "schema:description": "Бумажные пакеты с логотипом: крафтовые, белые мелованные, подарочные. Ручные ручки, скрученные, с застежкой. Размеры от 18x22 до 50x60 см."
    },
    {
      "@id": "cifra:service_poligrafiya_teybl_tent",
      "@type": "cifra:PrintService",
      "rdfs:label": "Тейбл-тент",
      "rdfs:comment": "Настольные талончики-тенты для ресторанов, кафе, офисов",
      "cifra:hasPrintMethod": ["cifra:DigitalPrint", "cifra:OffsetPrint"],
      "cifra:hasFinishing": ["cifra:Lamination", "cifra:UVVarnish"],
      "schema:description": "Настольные талончики-тенты (тент-карточки) для ресторанов, кафе, офисов. Двусторонняя печать, ламинация, складная конструкция."
    },
    {
      "@id": "cifra:service_poligrafiya_folgirovanie",
      "@type": "cifra:PostPressService",
      "rdfs:label": "Фольгирование",
      "rdfs:comment": "Фольгирование горячее и холодное: золото, серебро, голограмма, пигментные фольги",
      "cifra:hasFinishing": "cifra:Foiling",
      "schema:description": "Фольгирование горячее (золото, серебро, цветные фольги, голограмма) и холодное. Тиснение фольгой без пресса. Эффект металлического блеска."
    }
