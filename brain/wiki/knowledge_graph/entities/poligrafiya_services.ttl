    {
      "@id": "cifra:service_poligrafiya_beydzhi",
      "@type": "cifra:PrintService",
      "rdfs:label": "Бейджи",
      "rdfs:comment": "Бейджи с логотипом: магнитные, на заколке, на шпильке",
