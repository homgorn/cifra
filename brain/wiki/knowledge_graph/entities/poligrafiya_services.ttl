    {
      "@id": "cifra:service_poligrafiya_tsifrovaya_pechat",
      "@type": "cifra:DigitalPrintService",
      "rdfs:label": "Цифровая печать",
      "rdfs:comment": "Цифровая печать малых тиражей от 1 часа",
      "cifra:hasPrintMethod": "cifra:DigitalPrint",
      "cifra:hasMinTirage": 1,
      "cifra:hasMaxTirage": 500,
      "cifra:hasProductionTime": "PT1H",
      "schema:description": "Цифровая печать малых тиражей от 1 часа. Идеально для срочных заказов, пробных тиражей, персонализированной печати."
    },
    {
