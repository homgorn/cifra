      "cifra:hasPrintMethod": ["cifra:DigitalPrint", "cifra:OffsetPrint"],
      "cifra:hasFinishing": ["cifra:DieCutting", "cifra:Gluing"],
      "schema:description": "Высечные изделия: коробки вырубные, коробки для доставки, POS-материалы, столбики, таблетки, воблеры, диспенсеры."
    },
    {
      "@id": "cifra:service_poligrafiya_konverty",
      "@type": "cifra:PrintService",
      "rdfs:label": "Конверты",
      "rdfs:comment": "Конверты с логотипом: Е65, С5, С4, С6, DL",
      "cifra:hasPrintMethod": ["cifra:DigitalPrint", "cifra:OffsetPrint"],
      "schema:description": "Конверты европейских форматов с логотипом компании. Меховой клей, силиконовый клей. Белизна, крафт, дизайнерский картон."
    },
    {
      "@id": "cifra:service_poligrafiya_korobki_vyrubnye",
      "@type": "cifra:PrintService",
      "rdfs:label": "Коробки вырубные",
      "rdfs:comment": "Вырубные коробки из гофрокартона и микрогофрокартона",
      "cifra:hasPrintMethod": ["cifra:OffsetPrint", "cifra:FlexoPrint"],
      "cifra:hasFinishing": ["cifra:DieCutting", "cifra:Gluing", "cifra:Lamination"],
      "schema:description": "Вырубные коробки из гофрокартона (Т-21, Т-22, Т-23, Т-24) и микрогофрокартона (Е-качество). Автоматические и ручные сборки."
    },
    {
      "@id": "cifra:service_poligrafiya_lekala_vykroyki",
      "@type": "cifra:PrintService",
      "rdfs:label": "Лекала, выкройки",
