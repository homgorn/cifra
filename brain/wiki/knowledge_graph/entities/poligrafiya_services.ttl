      "cifra:hasPrintMethod": "cifra:UVVarnish",
      "cifra:hasFinishing": "cifra:UVVarnish",
      "schema:description": "УФ-лакирование выборочное (локальное) и сплошное. Создает объемный эффект, защищает от выцветания и механических повреждений."
    },
    {
      "@id": "cifra:service_poligrafiya_papki",
      "@type": "cifra:PrintService",
      "rdfs:label": "Папки",
      "rdfs:comment": "Папки для документов с логотипом",
      "cifra:hasPrintMethod": ["cifra:DigitalPrint", "cifra:OffsetPrint"],
      "cifra:hasFinishing": ["cifra:Lamination", "cifra:UVVarnish"],
