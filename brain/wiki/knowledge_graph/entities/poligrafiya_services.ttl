      "rdfs:label": "Ламинирование",
      "rdfs:comment": "Ламинирование глянцевое, матовое, софт-тач",
      "cifra:hasFinishing": "cifra:Lamination",
      "schema:description": "Ламинирование глянцевое, матовое, софт-тач. Защита печатной продукции от износа, влаги, выцветания."
    },
    {
      "@id": "cifra:service_poligrafiya_plotternaya_rezka",
      "@type": "cifra:PostPressService",
      "rdfs:label": "Плоттерная резка",
      "rdfs:comment": "Контурная резка пленки, бумаги, картона",
      "schema:description": "Плоттерная резка (контурная резка) — высокоточная резка разных материалов: самоклеящаяся пленка ПВХ, бумага, картон. Вырезание по контуру любой сложности.",
      "cifra:hasFinishing": "cifra:DieCutting"
    },
    {
      "@id": "cifra:service_poligrafiya_pechat_belym_tonerom",
