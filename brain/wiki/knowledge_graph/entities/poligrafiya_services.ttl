      "rdfs:label": "Печать белым тонером",
      "rdfs:comment": "Печать белым тонером на темных материалах",
      "cifra:hasPrintMethod": "cifra:WhiteTonerPrint",
      "schema:description": "Уникальная технология печати белым тонером на темных и цветных материалах: крафте, черном картоне, цветной бумаге, тканях."
    },
    {
      "@id": "cifra:service_poligrafiya_postpechatnye_raboty",
      "@type": "cifra:PostPressService",
      "rdfs:label": "Постпечатные работы",
      "rdfs:comment": "Ламинирование, фольгирование, тиснение, конгрев, скругление углов, плоттерная резка",
      "schema:description": "Полный спектр постпечатной обработки: ламиниция (глянцевая, матовая, софт-тач), фольгирование (золото, серебро, цветные фольги, голограмма), тиснение (слепое, фольгированное), конгрев, скругление углов, плоттерная резка."
    },
    {
