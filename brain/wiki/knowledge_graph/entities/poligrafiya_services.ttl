      "cifra:hasMinTirage": 10,
      "schema:description": "Бейджи с логотипом для сотрудников, мероприятий, конференций. Магнитные, на заколке, на шпильке, с ленярдом."
    },
    {
      "@id": "cifra:service_poligrafiya_laminirovanie",
